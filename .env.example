# Canonical origin (sitemap, robots, metadata)
NEXT_PUBLIC_SITE_URL=https://unclehangul.com
NEXT_PUBLIC_TOOLS_SITE_URL=https://tools.unclehangul.com
NEXT_PUBLIC_PACK_SITE_URL=https://pack.unclehangul.com

# Google Analytics 4 (optional — Measurement ID from GA4 Admin → Data streams)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Custom dimensions & Explore setup: docs/GA4-SETUP.md

# Pack Optimizer engine API (server proxy for /api/v1/optimize)
PACK_OPTIMIZER_API_UPSTREAM=https://pack.unclehangul.com

# 행정안전부 주소기반산업지원서비스 (https://business.juso.go.kr)
# 영문주소 검색 API 승인키 (required for live KR address search)
JUSO_API_KEY=
# Optional dedicated keys if you applied for each API separately
# JUSO_ENG_API_KEY=
# JUSO_KOR_API_KEY=

# Google AdSense (optional until approved)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_TOOLS=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_ACTION=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_RESULT=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_ANCHOR=

# Keystatic CMS (optional — default is local filesystem)
# KEYSTATIC_STORAGE=github
# KEYSTATIC_GITHUB_REPO=hyggetime/unclehangul
